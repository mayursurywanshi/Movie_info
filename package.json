{
  "name": "movie_info",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run start --workspace=frontend",
    "frontend": "npm run start --workspace=frontend",
    "backend": "npm run start --workspace=backend",
    "server": "concurrently --kill-others-on-fail --names FRONTEND,BACKEND --prefix-colors cyan,magenta \"npm run frontend\" \"npm run backend\"",
    "build": "npm run build --workspace=frontend",
    "test": "npm run test --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
